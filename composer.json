{
    "name": "ilbronza/contacts",
    "description": "Polymorphic contacts, contact types and Laravel CRUD integrations.",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide@sistema.srl",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/contacts",
    "keywords": [
        "Laravel",
        "Contacts"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^9.52.21 || >=10.48",
        "ilbronza/crud": "*",
        "ilbronza/buttons": "*",
        "ilbronza/datatables": "*",
        "ilbronza/form": "*",
        "ilbronza/uikittemplate": "*",
        "ilbronza/menu": "*",
        "ilbronza/accountmanager": "*",
        "ilbronza/formfield": "*",
        "ilbronza/ukn": "*",
        "spatie/laravel-permission": ">=5.11",
        "spatie/laravel-activitylog": ">=4.0",
        "spatie/laravel-medialibrary": ">=10.13"
    },
    "require-dev": {
        "orchestra/testbench": ">=8.0",
        "phpunit/phpunit": ">=10.5"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\Contacts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Contacts\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Contacts\\ContactsServiceProvider"
            ],
            "aliases": {
                "Contacts": "IlBronza\\Contacts\\Facades\\Contacts"
            }
        }
    },
    "suggest": {
        "ilbronza/clients": "Enables the default Client contact owner.",
        "ilbronza/operators": "Enables the default Operator contact owner."
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
